# Template for ~/.config/local-agent-team/dev-agent.env (chmod 600).
# Source it before running the Feishu bot or CLI; never commit a filled-in copy.

ANTHROPIC_API_KEY=             # pay-per-token Messages API key (subscription auth not allowed headless)
FEISHU_WEBHOOK_URL=            # legacy one-way group webhook (channels/feishu.py)
FEISHU_SECRET=                 # webhook signing secret
FEISHU_APP_ID=                 # inbound bot app (channels/feishu_bot.py, long-connection)
FEISHU_APP_SECRET=
DEVAGENT_LLM_MODEL=            # brain-phase model id
DEVAGENT_BUILD_MODEL=          # build/executor model id
DEVAGENT_GITLAB_URL=           # self-hosted forge for M7 git publishing
DEVAGENT_GITLAB_TOKEN=         # api-scope PAT (repo create + push)
DEVAGENT_GITLAB_GROUP=
SSL_CERT_FILE=                 # combined CA bundle — bare private CA breaks Feishu TLS (see README)
